		{
			dependencies: ["49001B4F8FF6A5D9"]
			description: [
				"Function 1 :"
				""
				"You can imprint a &6Spell Scroll&r onto a weapon, allowing the spell to become the weapon’s right-click ability. (Enhancements can be removed at a smithing table using a Shriving Stone)"
				"&7(Note: This will disable other right-click interactions of the item.)&r"
				""
				"{image:kubejs:textures/task/isb_1_1.png width:170 height:70 align:1}"
				""
				""
				"{@pagebreak}"
				"Function 2 :"
				""
				"Use Upgrade Orbs to &2upgrade your gears&r. (The upgrades can also be removed at a smithing table using a Shriving Stone)"
				""
				"{image:kubejs:textures/task/isb_1_2.png width:170 height:70 align:1}"
				""
				"{@pagebreak}"
				"Function 3 :"
				""
				"Combine two identical scrolls to create a higher-tier version of the scroll."
				""
				"{image:kubejs:textures/task/isb_1_3.png width:170 height:70 align:1}"
			]
			hide_dependency_lines: false
			id: "4E574A8D228115B3"
			rewards: [{
				id: "5B5ED1B7BD177958"
				item: "lightmanscurrency:coin_gold"
				type: "item"
			}]
			shape: "square"
			tasks: [{
				id: "59CF2BFFFA748B93"
				item: "irons_spellbooks:arcane_anvil"
				type: "item"
			}]
			x: -1.0d
			y: -6.0d
		}
		{
			dependencies: ["49001B4F8FF6A5D9"]
			description: [
				"{image:kubejs:textures/task/isb_2.png width:170 height:108 align:1}"
				""
				"You can use the Inscription Table to inscribe spell scrolls into your spellbook, or extract spells from your spellbook back into scrolls."
				""
				"1. Place the &6Spellbook&r"
				""
				"2. Place the &6Scroll&r"
				""
				"3. Start inscribing"
				""
				"4. Choose the slot where the spell will be inscribed"
				""
				"5. Extract the selected spell back into a spell scroll"
				""
				"Note: The quality of the scroll cannot exceed the quality of the spellbook; otherwise, the inscribing process will fail."
			]
			hide_dependency_lines: false
			id: "14479C9FE223E066"
			rewards: [{
				id: "2DAF7F70EBB22EC9"
