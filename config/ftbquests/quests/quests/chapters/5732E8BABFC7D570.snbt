			x: -0.75d
			y: 7.25d
		}
		{
			dependencies: ["5ECDE24F7C16B68D"]
			description: [
				"The Witch’s Cauldron is the core block for making Witch's Brews, but several preparations are required before you can begin:"
				""
				"&6Heat source :&r Place a &2campfire, soul campfire, or magma block&r &ebelow&r the &6Witch’s Cauldron&r to provide &eheating&r."
				""
				"&bSoul Energy source :&r Prepare a &6Cursed Cage&r and a &6Soul Candlestick&r around the cauldron. The Soul Candlestick must be placed on top of a Cursde Cage containing soul energy."
				""
				"&9Water source :&r Use a &6water bucket&r to fill the cauldron with water."
				""
				"&7(If needed, turn the page to view the example diagram.)&r"
				""
				"{@pagebreak}"
				"Example setup of a Witch’s Cauldron:"
				""
				"{image:kubejs:textures/task/goety_6.png width:150 height:96 align:1}"
			]
			id: "3CB4A421BFE6A3BC"
			rewards: [{
				id: "0B074A4F964AC58C"
