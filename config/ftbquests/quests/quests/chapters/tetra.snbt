		{
			dependencies: ["312A09022249980F"]
			description: [
				"Tools can be broadly classified into &ebelts, double headed tools, and single headed tools&r."
				""
				"Sometimes, modifying tools can provide convenience beyond resource gathering, extending into general gameplay and quality-of-life improvements."
				""
				"The following sections will briefly describe possible modification paths for certain tools, offering players guidance and inspiration for customization."
			]
			hide_dependency_lines: false
			icon: "witherstormmod:command_block_pickaxe"
			id: "6DCBC9E0C68FCAB4"
