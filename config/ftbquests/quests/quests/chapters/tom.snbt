	quests: [
		{
			description: [
				"Are you often rummaging through chests only to find nothing you need?"
				"Do you feel overwhelmed by the sheer number of item types when organizing storage?"
				""
				"Try &6Tom’s Simple Storage&r!"
				""
				"No power required,effortlessly solve all your storage problems."
			]
			icon: "toms_storage:ts.inventory_connector"
			id: "4806938A4DAB5634"
