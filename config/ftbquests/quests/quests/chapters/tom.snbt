			}]
			title: "Simple Simple Storage"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["4806938A4DAB5634"]
			description: [
				"Used in combination with the &6Storage Terminal&r, this system integrates large numbers of adjacent containers into a single complete block-based storage solution."
				""
				"Placed next to any container (on any of its six sides), it will automatically detect and link to it, forming a &dstorage network&r. Right-clicking the &6Inventory Connector&r will display the total storage capacity and remaining available slots of all connected containers."
				""
				"If the container is adjacent to others, the &6Inventory Connector&r will treat them as a single unified system. Its maximum connection range is 16 blocks (theoretically allowing it to link all containers within a 32×32×32 area centered on the integrator)."
			]
			id: "7843988CB0F906B3"
			rewards: [{
				count: 8
				id: "36397C2C40CEEC9A"
				item: "minecraft:barrel"
				type: "item"
			}]
			subtitle: "Connect the storage network"
			tasks: [{
				id: "5B673BB7287B4024"
				item: "toms_storage:ts.inventory_connector"
				type: "item"
			}]
			x: 2.0d
			y: 0.0d
		}
