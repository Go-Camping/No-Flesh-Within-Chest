						}]
					}
				}
				type: "item"
			}]
			subtitle: "I believe i can fly"
			tasks: [{
				id: "390FA83F430207D7"
				type: "checkmark"
			}]
			title: "Magic and Flying Broom"
			x: 3.75d
			y: 11.25d
		}
		{
			dependencies: ["5B62D052AA6FF2D3"]
			description: [
				"&6Dipper&r is a device with limited uses, but it is required to craft &6candles&r in the &dHexerei&r mod. &2(Hold Shift while hovering over the Dipper to view detailed information.)&r"
				""
				"Now, follow the recipe to craft the Dipper!"
				""
				"After crafting, if you want to pour out lava from the Mixing Cauldron, move your cursor to the fluid container area. A pop-up panel will appear—simply click it to drain the fluid. &7(As shown below.)&r"
				""
				"{image:kubejs:textures/task/hexerei_2.png width:100 height:60 align:1}"
			]
			id: "5DD1124BDBF1D5EC"
			rewards: [{
				count: 2
				id: "5C85989EF8D5705C"
