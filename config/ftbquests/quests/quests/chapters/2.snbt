		{
			dependencies: ["03B3A54BEDB85320"]
			description: [
				"At this point, most of the mods in this modpack have been &2fully introduced&r, and the “questline” within the pack can be considered &dcomplete&r."
				""
				"Try defeating &2various bosses&r and collecting &2a wider variety of organs&r, only then will you be able to"
				""
				"&8uncover the secret hidden within your memories.&r"
			]
			icon: "minecraft:oak_sapling"
			id: "2EBB4C697D81D42A"
			rewards: [{
				count: 2
				id: "61D2E13ED3514B25"
