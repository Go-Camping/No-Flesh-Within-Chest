			x: 3.5d
			y: 4.25d
		}
		{
			dependencies: ["4452DA9A1D3D80A0"]
			description: [
				"A basic portal consists of 9 &6Stone Bricks&r, 2 &6Gilded Portal Blocks&r, and 1 &6Portal Keystone&r, all of which can be crafted using a crafting table."
				""
				""
				"{image:kubejs:textures/task/dimensiona_2.png width:160 height:80 align:1}"
				""
				""
				"{@pagebreak}"
				"Hold a blank Portal Key and &eright-click&r the center of an &6End Portal Frame&r (as shown in the red box in the image) to obtain a randomly generated new Portal Key. Place this key into the &6Portal Keystone&r to activate the portal."
				""
				"&7(The portal may experience lag or delay during activation; please be patient.)&r"
				""
				"{image:kubejs:textures/task/dimensiona_1.png width:100 height:100 align:1}"
			]
