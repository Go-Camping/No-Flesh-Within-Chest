	quests: [
		{
			description: [
				"Why is this guide necessary?"
				""
				"Some organs in this modpack are obtained through fairly complicated processes. Without guidance, learning how to craft &6advance organs&r can be very overwhelming for players, especially in singleplayer."
				""
				"This guide is meant to help players understand how to obtain some of the more advanced organs step by step."
				""
				"At the same time, it also introduces several classic and popular &2organ builds&r from the modpack, giving players examples to learn from or use as inspiration for their own setups."
			]
			icon: "chestcavity:chest_opener"
